{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "anybaek-next-web",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",

  // public/ 폴더를 정적 파일로 내보낸다. /api/* 만 Worker 가 먼저 받는다.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },

  // Cloudflare Email Service. anybaek.com 을 Email Sending 에 등록해야 실제로 보내진다.
  "send_email": [{ "name": "EMAIL" }],

  "vars": {
    "CONTACT_TO": "contact@anybaek.com",
    "CONTACT_FROM": "noreply@anybaek.com",
    // 관리자 페이지(/admin/)에서 고객에게 보낼 때의 보내는 주소와 이름
    "ADMIN_FROM": "contact@anybaek.com",
    "ADMIN_FROM_NAME": "AnyBaek"
  },
  // 관리자 비밀번호는 Secret 으로 넣는다: npx wrangler secret put ADMIN_PASSWORD

  // 관리자 로그인 시도 제한: IP 하나당 1분에 5번
  "ratelimits": [
    { "name": "LOGIN_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ],

  "observability": { "enabled": true }

  // 도메인을 이 Worker 로 옮길 준비가 되면 아래 주석을 풀고 다시 배포한다.
  // 지금 anybaek.com 에 연결된 기존 사이트가 이 Worker 로 바뀐다.
  // "routes": [
  //   { "pattern": "anybaek.com", "custom_domain": true },
  //   { "pattern": "www.anybaek.com", "custom_domain": true }
  // ]
}
